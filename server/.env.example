NODE_ENV=development
PORT=4000


CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://username:password@localhost:5432/PRPG06

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
EMAIL=your-gmail-address@gmail.com
PASSWORD=your-gmail-app-password

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional Mailtrap settings
MAILTRAP_TOKEN=
MAILTRAP_FROM_EMAIL=noreply@yourapp.com

# Optional test seed password
SEED_TEST_PASSWORD=Test123456
